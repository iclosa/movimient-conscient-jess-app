{
  "expo": {
    "name": "Moviment Conscient",
    "slug": "moviment-conscient-app",
    "scheme": "movimentconscient",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cat.movimentconscient.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "cat.movimentconscient.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF3DF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7EF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-localization",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
